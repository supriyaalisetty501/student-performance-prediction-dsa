# Byte-compiled / cache files
__pycache__/
*.py[cod]
*.pyc

# Virtual environments
venv/
env/
.venv/

# Logs (runtime-generated, not part of source)
logs/*.log

# Generated data & charts (reproducible from raw dataset + code)
data/processed/*.csv
charts/*.png

# IDE / OS files
.vscode/
.idea/
.DS_Store

# Keep folder structure in git even though contents are ignored
!data/raw/.gitkeep
!data/processed/.gitkeep
!charts/.gitkeep
!logs/.gitkeep
